{"elevator-001": {"raw": "電梯", "pos": 10576, "ph": []}, "elevator-002": {"raw": "搭電梯", "pos": 10648, "ph": []}, "elevator-003": {"raw": "\n    Ami 住在公寓大樓。今天你要去她家，要搭電梯上樓。電梯裡有按鈕，還會遇到鄰居，要用客氣的話。", "pos": 11682, "ph": []}, "elevator-004": {"raw": "走到電梯前", "pos": 20483, "ph": []}, "elevator-005": {"raw": "電梯來了", "pos": 20498, "ph": []}, "elevator-006": {"raw": "走進電梯", "pos": 20513, "ph": []}, "elevator-007": {"raw": "電梯往上", "pos": 20527, "ph": []}, "elevator-008": {"raw": "電梯停了", "pos": 20541, "ph": []}, "elevator-009": {"raw": "繼續往上", "pos": 20557, "ph": []}, "elevator-010": {"raw": "到Ami家", "pos": 20570, "ph": []}, "elevator-011": {"raw": "公寓大樓", "pos": 20674, "ph": []}, "elevator-012": {"raw": "Ami：${N}，我住在${t.n}樓。大樓門口進來就有電梯，你自己上來。", "pos": 24620, "ph": [["名字", "N"], ["幾樓", "t.n"]]}, "elevator-013": {"raw": "Ami：電梯裡面可能會遇到鄰居，要有禮貌喔！", "pos": 24849, "ph": []}, "elevator-014": {"raw": "（你走到Ami住的公寓大樓。手機響了一聲，是Ami傳來的LINE。）", "pos": 26539, "ph": []}, "elevator-015": {"raw": "我：好，我現在上去！", "pos": 26771, "ph": []}, "elevator-016": {"raw": "走進大樓", "pos": 26858, "ph": []}, "elevator-017": {"raw": "（你在一樓大廳，電梯門前有兩個按鈕：▲和▼。）", "pos": 27046, "ph": []}, "elevator-018": {"raw": "我：Ami住在${t.n}樓，我要按哪一個？", "pos": 27250, "ph": [["幾樓", "t.n"]]}, "elevator-019": {"raw": "按▲，往上。", "pos": 27414, "ph": []}, "elevator-020": {"raw": "按▼，往下。", "pos": 27424, "ph": []}, "elevator-021": {"raw": "不按，站在旁邊等。", "pos": 27434, "ph": []}, "elevator-022": {"raw": "Ami住在${t.n}樓，在一樓要往上。", "pos": 27520, "ph": [["幾樓", "t.n"]]}, "elevator-023": {"raw": "沒錯！去更高的樓層，要按「往上」。", "pos": 27702, "ph": []}, "elevator-024": {"raw": "（電梯來了，門打開了。你走進去。）", "pos": 27866, "ph": []}, "elevator-025": {"raw": "（門快要關了。這時候，一位鄰居跑過來。）", "pos": 28154, "ph": []}, "elevator-026": {"raw": "等一下！等一下！", "pos": 28305, "ph": []}, "elevator-027": {"raw": "按「開門」，等他。", "pos": 28382, "ph": []}, "elevator-028": {"raw": "按「關門」。", "pos": 28395, "ph": []}, "elevator-029": {"raw": "不要動，假裝沒看到。", "pos": 28405, "ph": []}, "elevator-030": {"raw": "鄰居在跑，要按「開門」等他。", "pos": 28495, "ph": []}, "elevator-031": {"raw": "很有禮貌！在台灣，幫別人按開門鍵很常見。", "pos": 28674, "ph": []}, "elevator-032": {"raw": "謝謝你！", "pos": 28862, "ph": []}, "elevator-033": {"raw": "（電梯裡有一排樓層按鈕。）", "pos": 29055, "ph": []}, "elevator-034": {"raw": "我：Ami住在${t.n}樓。", "pos": 29182, "ph": [["幾樓", "t.n"]]}, "elevator-035": {"raw": "按${n}樓。", "pos": 29325, "ph": [["幾樓", "n"]]}, "elevator-036": {"raw": "Ami住在${t.n}樓。", "pos": 29411, "ph": [["幾樓", "t.n"]]}, "elevator-037": {"raw": "對了！按${t.n}樓。", "pos": 29530, "ph": [["幾樓", "t.n"]]}, "elevator-038": {"raw": "不好意思，我到${t.m}樓，麻煩你幫我按。", "pos": 29634, "ph": [["中途幾樓", "t.m"]]}, "elevator-039": {"raw": "不好意思，我到${t.m}樓，麻煩你幫我按。", "pos": 29952, "ph": [["中途幾樓", "t.m"]]}, "elevator-040": {"raw": "好，我幫你按${t.m}樓。", "pos": 30143, "ph": [["中途幾樓", "t.m"]]}, "elevator-041": {"raw": "好，我幫你按${t.n}樓。", "pos": 30161, "ph": [["幾樓", "t.n"]]}, "elevator-042": {"raw": "我不會說中文。", "pos": 30179, "ph": []}, "elevator-043": {"raw": "鄰居只是請你幫忙按一個鈕，很簡單。", "pos": 30290, "ph": []}, "elevator-044": {"raw": "鄰居要到${t.m}樓。", "pos": 30427, "ph": [["中途幾樓", "t.m"]]}, "elevator-045": {"raw": "很好！你聽懂了他要去幾樓。", "pos": 30557, "ph": []}, "elevator-046": {"raw": "（電梯往上，在${t.m}樓停了，門打開。）", "pos": 30717, "ph": [["中途幾樓", "t.m"]]}, "elevator-047": {"raw": "到了，謝謝你！再見！", "pos": 30889, "ph": []}, "elevator-048": {"raw": "到了，謝謝你！再見！", "pos": 31124, "ph": []}, "elevator-049": {"raw": "不客氣，慢走！", "pos": 31232, "ph": []}, "elevator-050": {"raw": "你走錯了！", "pos": 31243, "ph": []}, "elevator-051": {"raw": "（不說話）", "pos": 31252, "ph": []}, "elevator-052": {"raw": "鄰居要下電梯，可以說「慢走」。", "pos": 31335, "ph": []}, "elevator-053": {"raw": "「慢走」是跟離開的人說的客氣話。", "pos": 31482, "ph": []}, "elevator-054": {"raw": "（電梯繼續往上，到${t.n}樓了。門口站了很多人，你前面有人擋著。）", "pos": 31656, "ph": [["幾樓", "t.n"]]}, "elevator-055": {"raw": "（${t.n}樓到了，門開了。可是前面有人站著。）", "pos": 32058, "ph": [["幾樓", "t.n"]]}, "elevator-056": {"raw": "我：我要出去……", "pos": 32227, "ph": []}, "elevator-057": {"raw": "不好意思，借過一下。", "pos": 32308, "ph": []}, "elevator-058": {"raw": "走開！", "pos": 32322, "ph": []}, "elevator-059": {"raw": "（用力推開）", "pos": 32329, "ph": []}, "elevator-060": {"raw": "要出去時，客氣地說「借過一下」。", "pos": 32416, "ph": []}, "elevator-061": {"raw": "很好！「借過」是請別人讓路。", "pos": 32552, "ph": []}, "elevator-062": {"raw": "（你走到Ami家門口，按了電鈴。）", "pos": 32983, "ph": []}, "elevator-063": {"raw": "Ami：${N}，你來了！電梯很好搭吧？歡迎歡迎！", "pos": 33144, "ph": [["名字", "N"]]}, "elevator-064": {"raw": "Ami：${N}，你終於來了！剛剛好像有點不順利？沒關係，進來吧！", "pos": 33309, "ph": [["名字", "N"]]}}