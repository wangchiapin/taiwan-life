{"icecream-001": {"raw": "冰淇淋", "pos": 11929, "ph": []}, "icecream-002": {"raw": "冰淇淋店", "pos": 12002, "ph": []}, "icecream-003": {"raw": "\n    Ami 想吃冰淇淋，請你去冰淇淋店幫她買。要幾球、什麼口味、杯子還是甜筒、加不加配料、內用還是外帶，都要照她說的點。", "pos": 13034, "ph": []}, "icecream-004": {"raw": "走到櫃台", "pos": 23139, "ph": []}, "icecream-005": {"raw": "回答店員", "pos": 23158, "ph": []}, "icecream-006": {"raw": "看冰淇淋", "pos": 23174, "ph": []}, "icecream-007": {"raw": "繼續點", "pos": 23191, "ph": []}, "icecream-008": {"raw": "繼續點", "pos": 23203, "ph": []}, "icecream-009": {"raw": "付錢", "pos": 23215, "ph": []}, "icecream-010": {"raw": "拿冰淇淋", "pos": 23226, "ph": []}, "icecream-011": {"raw": "Ami：${N}，我${here ? '已經在冰淇淋店裡面坐好了' : '在公園的長椅這邊等你'}。幫我買一個冰淇淋，好嗎？", "pos": 29068, "ph": [["名字", "N"], ["已經在冰淇淋店裡面坐好了／在公園的長椅這邊等你", "here ? '已經在冰淇淋店裡面坐好了' : '在公園的長椅這邊等你'"]]}, "icecream-012": {"raw": "Ami：我要${NZ(t.n)}球。${ordZh}。", "pos": 29420, "ph": [["幾球（中文）", "NZ(t.n)"], ["口味順序", "ordZh"]]}, "icecream-013": {"raw": "Ami：我要${t.vessel.zh}，${t.top ? `還要加${t.top.zh}` : '不要加配料'}。", "pos": 29530, "ph": [["容器（杯子／甜筒）", "t.vessel.zh"], ["有時加：不要加配料", "t.top ? `還要加${t.top.zh}` : '不要加配料'"]]}, "icecream-014": {"raw": "Ami：我們在這裡吃。", "pos": 29767, "ph": []}, "icecream-015": {"raw": "Ami：我要外帶，帶去公園吃。", "pos": 29783, "ph": []}, "icecream-016": {"raw": "加${t.otherTop2.zh}。", "pos": 33694, "ph": [["另一個配料", "t.otherTop2.zh"]]}, "icecream-017": {"raw": "加${TOPS.find(x => x !== t.otherTop2).zh}。", "pos": 33717, "ph": [["配料", "TOPS.find(x => x !== t.otherTop2).zh"]]}, "icecream-018": {"raw": "（你走到冰淇淋店門口。手機響了一聲，是Ami傳來的LINE。）", "pos": 33950, "ph": []}, "icecream-019": {"raw": "我：好，我現在去買！", "pos": 34183, "ph": []}, "icecream-020": {"raw": "走進冰淇淋店", "pos": 34286, "ph": []}, "icecream-021": {"raw": "你好，歡迎光臨！請問要幾球？", "pos": 34503, "ph": []}, "icecream-022": {"raw": "一球。", "pos": 34632, "ph": []}, "icecream-023": {"raw": "兩球。", "pos": 34639, "ph": []}, "icecream-024": {"raw": "三球。", "pos": 34646, "ph": []}, "icecream-025": {"raw": "Ami要${NZ(t.n)}球。", "pos": 34743, "ph": [["幾球（中文）", "NZ(t.n)"]]}, "icecream-026": {"raw": "很好！「球」是冰淇淋的量詞。", "pos": 34883, "ph": []}, "icecream-027": {"raw": "好的。", "pos": 35053, "ph": []}, "icecream-028": {"raw": "請問要杯子還是甜筒？", "pos": 35240, "ph": []}, "icecream-029": {"raw": "要杯子。", "pos": 35353, "ph": []}, "icecream-030": {"raw": "要甜筒。", "pos": 35361, "ph": []}, "icecream-031": {"raw": "Ami要${t.vessel.zh}。", "pos": 35464, "ph": [["容器（杯子／甜筒）", "t.vessel.zh"]]}, "icecream-032": {"raw": "你記得Ami說的話，真棒！", "pos": 35619, "ph": []}, "icecream-033": {"raw": "好的，${t.vessel.zh}。", "pos": 35814, "ph": [["容器（杯子／甜筒）", "t.vessel.zh"]]}, "icecream-034": {"raw": "第${CN[Game.k + 1]}球要什麼口味？", "pos": 36097, "ph": [["第幾球", "CN[Game.k + 1]"]]}, "icecream-035": {"raw": "第${CN[Game.k + 1]}球，Ami要的是${f.zh}。", "pos": 36430, "ph": [["第幾球", "CN[Game.k + 1]"], ["口味", "f.zh"]]}, "icecream-036": {"raw": "（店員把${f.zh}冰淇淋放在${Game.vessel.zh}裡。）", "pos": 36835, "ph": [["口味", "f.zh"], ["容器（杯子／甜筒）", "Game.vessel.zh"]]}, "icecream-037": {"raw": "（店員把${f.zh}放在最上面。）", "pos": 37035, "ph": [["口味", "f.zh"]]}, "icecream-038": {"raw": "要加配料嗎？配料一種十元。", "pos": 37334, "ph": []}, "icecream-039": {"raw": "Ami要加${t.top.zh}。", "pos": 37601, "ph": [["配料", "t.top.zh"]]}, "icecream-040": {"raw": "Ami說不要加配料。", "pos": 37679, "ph": []}, "icecream-041": {"raw": "很好！你沒有多加配料，也沒有漏掉。", "pos": 37818, "ph": []}, "icecream-042": {"raw": "（店員在冰淇淋上面加了${t.top.zh}。）", "pos": 38009, "ph": [["配料", "t.top.zh"]]}, "icecream-043": {"raw": "請問內用還是外帶？", "pos": 38312, "ph": []}, "icecream-044": {"raw": "Ami${t.eat === 'here' ? '已經在店裡面坐好了，要內用' : '在公園等你，要外帶'}。", "pos": 38520, "ph": [["已經在店裡面坐好了，要內用／在公園等你，要外帶", "t.eat === 'here' ? '已經在店裡面坐好了，要內用' : '在公園等你，要外帶'"]]}, "icecream-045": {"raw": "（你有一張一百元和一張兩百元。）", "pos": 39413, "ph": []}, "icecream-046": {"raw": "給你一百元。", "pos": 39585, "ph": []}, "icecream-047": {"raw": "我下次再付，可以嗎？", "pos": 39595, "ph": []}, "icecream-048": {"raw": "一共是${t.total}元，一百元不夠。", "pos": 39722, "ph": [["總價", "t.total"]]}, "icecream-049": {"raw": "買東西要先付錢，不能賒帳。", "pos": 39867, "ph": []}, "icecream-050": {"raw": "沒錯！一百元不夠，要給兩百元，他會找錢給你。", "pos": 40043, "ph": []}, "icecream-051": {"raw": "收你兩百元，找你${zhNum(200 - t.total)}元。", "pos": 40234, "ph": [["找的錢（中文）", "zhNum(200 - t.total)"]]}, "icecream-052": {"raw": "好了，這是您的冰淇淋，請慢用！", "pos": 40814, "ph": []}, "icecream-053": {"raw": "（你把冰淇淋拿給Ami。）", "pos": 40937, "ph": []}, "icecream-054": {"raw": "（你走到公園，把冰淇淋拿給Ami。）", "pos": 40955, "ph": []}, "icecream-055": {"raw": "Ami：哇，${NZ(t.n)}球都是我要的口味！謝謝你，${N}！", "pos": 41210, "ph": [["幾球（中文）", "NZ(t.n)"], ["名字", "N"]]}, "icecream-056": {"raw": "Ami：謝謝你！不過我等了好久……下次要快一點喔！", "pos": 41424, "ph": []}, "icecream-057": {"raw": "Ami：謝謝你！不過冰淇淋有一點融化了……下次要快一點喔！", "pos": 41454, "ph": []}}