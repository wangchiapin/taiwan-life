{"cinema-001": {"raw": "電影院", "pos": 12404, "ph": []}, "cinema-002": {"raw": "看電影", "pos": 12477, "ph": []}, "cinema-003": {"raw": "\n    Ami 和她弟弟小宇約你週末晚上看電影。你先到電影院：看看板、買票、選座位、買爆米花，還要找到對的廳。", "pos": 13499, "ph": []}, "cinema-004": {"raw": "走到售票櫃台", "pos": 25604, "ph": []}, "cinema-005": {"raw": "告訴售票員", "pos": 25623, "ph": []}, "cinema-006": {"raw": "看座位表", "pos": 25639, "ph": []}, "cinema-007": {"raw": "付錢", "pos": 25652, "ph": []}, "cinema-008": {"raw": "看一下找的錢", "pos": 25666, "ph": []}, "cinema-009": {"raw": "走到零食櫃台", "pos": 25683, "ph": []}, "cinema-010": {"raw": "走到驗票口", "pos": 25701, "ph": []}, "cinema-011": {"raw": "走進電影院", "pos": 25721, "ph": []}, "cinema-012": {"raw": "走到座位", "pos": 25742, "ph": []}, "cinema-013": {"raw": "坐好，電影開始了", "pos": 25757, "ph": []}, "cinema-014": {"raw": "電影結束了", "pos": 25774, "ph": []}, "cinema-015": {"raw": "Ami：${N}，我們今天晚上要看《${t.movie.zh}》，${this.timeZh()}那一場。", "pos": 34011, "ph": [["名字", "N"], ["電影名稱", "t.movie.zh"], ["場次時間", "this.timeZh()"]]}, "cinema-016": {"raw": "Ami：我、你、小宇和小美，四個人一起去。小宇和小美都是大學生，他們有學生證。", "pos": 34252, "ph": []}, "cinema-017": {"raw": "Ami：我、你和小宇，三個人一起去。小宇是大學生，他有學生證。", "pos": 34296, "ph": []}, "cinema-018": {"raw": "Ami：你先幫我們買票，座位要連在一起喔！${R.zh}", "pos": 34790, "ph": [["哪一列座位", "R.zh"]]}, "cinema-019": {"raw": "Ami：我要吃${sn[0]}爆米花，不要${other[0]}的喔！", "pos": 34991, "ph": [["爆米花口味（甜／鹹…）", "sn[0]"], ["另一種爆米花口味", "other[0]"]]}, "cinema-020": {"raw": "（你到了電影院門口。手機響了一聲，是Ami傳來的LINE。）", "pos": 40546, "ph": []}, "cinema-021": {"raw": "我：好，我先去買票！", "pos": 40772, "ph": []}, "cinema-022": {"raw": "走進電影院", "pos": 40885, "ph": []}, "cinema-023": {"raw": "（你走到售票櫃台，上面的電子看板列出今晚的電影。）", "pos": 41116, "ph": []}, "cinema-024": {"raw": "你好，請問要看哪一場？", "pos": 41325, "ph": []}, "cinema-025": {"raw": "Ami說的是${Game.timeZh()}那一場。", "pos": 41713, "ph": [["場次時間", "Game.timeZh()"]]}, "cinema-026": {"raw": "Ami要看的是《${t.movie.zh}》。", "pos": 41843, "ph": [["電影名稱", "t.movie.zh"]]}, "cinema-027": {"raw": "看得很仔細！買票以前，要先確認片名和時間。", "pos": 42005, "ph": []}, "cinema-028": {"raw": "好的。", "pos": 42189, "ph": []}, "cinema-029": {"raw": "請問要幾張票？", "pos": 42413, "ph": []}, "cinema-030": {"raw": "${nw(t.people, '全票')}。", "pos": 42531, "ph": [["有時加：全票", "nw(t.people, '全票')"]]}, "cinema-031": {"raw": "${nw(t.people, '學生票')}。", "pos": 42557, "ph": [["有時加：學生票", "nw(t.people, '學生票')"]]}, "cinema-032": {"raw": "小宇是大學生，他可以買學生票，比較便宜。", "pos": 42719, "ph": []}, "cinema-033": {"raw": "你和Ami不是學生，要買全票。", "pos": 42920, "ph": []}, "cinema-034": {"raw": "很好！學生票比較便宜，但是要出示學生證。", "pos": 43137, "ph": []}, "cinema-035": {"raw": "好，我看一下座位。", "pos": 43385, "ph": []}, "cinema-036": {"raw": "這是座位表，灰色的位子已經賣掉了。請選位子。", "pos": 44132, "ph": []}, "cinema-037": {"raw": "確定這些位子", "pos": 44356, "ph": []}, "cinema-038": {"raw": "你們有${t.people}個人，要選${t.people}個位子。", "pos": 44612, "ph": [["人數", "t.people"], ["人數", "t.people"]]}, "cinema-039": {"raw": "要坐在同一排。", "pos": 44833, "ph": []}, "cinema-040": {"raw": "號碼要連在一起，才能坐在一起。", "pos": 44994, "ph": []}, "cinema-041": {"raw": "Ami的要求：${R.zh}", "pos": 45189, "ph": [["哪一列座位", "R.zh"]]}, "cinema-042": {"raw": "選得很好！位子連在一起，也在Ami想坐的地方。", "pos": 45367, "ph": []}, "cinema-043": {"raw": "好，${seatZh(ks)}。", "pos": 45599, "ph": [["座位", "seatZh(ks)"]]}, "cinema-044": {"raw": "給你五百元。", "pos": 45866, "ph": []}, "cinema-045": {"raw": "可以算便宜一點嗎？", "pos": 45876, "ph": []}, "cinema-046": {"raw": "一共是${t.total}元，五百元不夠。", "pos": 46002, "ph": [["總價", "t.total"]]}, "cinema-047": {"raw": "電影院的票價是固定的，不能殺價。", "pos": 46153, "ph": []}, "cinema-048": {"raw": "沒錯！你沒有零錢，就付整張的錢，他會找錢給你。", "pos": 46349, "ph": []}, "cinema-049": {"raw": "收你${zhNum(t.bills * 1000)}元，找你${zhNum(Game.given)}元。", "pos": 46637, "ph": [["給的錢（中文）", "zhNum(t.bills * 1000)"], ["售票員找的錢（中文）", "zhNum(Game.given)"]]}, "cinema-050": {"raw": "（售票員把電影票和零錢放在桌上。）", "pos": 47143, "ph": []}, "cinema-051": {"raw": "好，謝謝。", "pos": 47346, "ph": []}, "cinema-052": {"raw": "不好意思，你找錯了。", "pos": 47355, "ph": []}, "cinema-053": {"raw": "找的錢是對的：${paid} − ${t.total} = ${t.change}。", "pos": 47586, "ph": [["給的錢", "paid"], ["總價", "t.total"], ["應該找的錢", "t.change"]]}, "cinema-054": {"raw": "應該找${t.change}元，不是${Game.given}元。${paid} − ${t.total} = ${t.change}。", "pos": 47772, "ph": [["應該找的錢", "t.change"], ["售票員找的錢", "Game.given"], ["給的錢", "paid"], ["總價", "t.total"], ["應該找的錢", "t.change"]]}, "cinema-055": {"raw": "（你收好電影票和零錢。）", "pos": 48550, "ph": []}, "cinema-056": {"raw": "啊，不好意思！這裡是${zhNum(t.change)}元。", "pos": 48673, "ph": [["應該找的錢（中文）", "zhNum(t.change)"]]}, "cinema-057": {"raw": "（你收好電影票和零錢。）", "pos": 48796, "ph": []}, "cinema-058": {"raw": "店員：你好，請問要點什麼？", "pos": 49041, "ph": []}, "cinema-059": {"raw": "一份${sn[0]}爆米花。", "pos": 49146, "ph": [["爆米花口味（甜／鹹…）", "sn[0]"]]}, "cinema-060": {"raw": "一份${other[0]}爆米花。", "pos": 49164, "ph": [["另一種爆米花口味", "other[0]"]]}, "cinema-061": {"raw": "一杯可樂就好。", "pos": 49185, "ph": []}, "cinema-062": {"raw": "Ami要吃爆米花，只買可樂不夠。", "pos": 49322, "ph": []}, "cinema-063": {"raw": "Ami說她要${sn[0]}爆米花，不要${other[0]}的。", "pos": 49458, "ph": [["爆米花口味（甜／鹹…）", "sn[0]"], ["另一種爆米花口味", "other[0]"]]}, "cinema-064": {"raw": "你記得Ami說的話，真棒！", "pos": 49674, "ph": []}, "cinema-065": {"raw": "店員：好的，請稍等。", "pos": 49801, "ph": []}, "cinema-066": {"raw": "（你拿著票走到驗票口。小宇${t.kids === 2 ? '和小美' : ''}也剛好到了。）", "pos": 50078, "ph": [["有時加：和小美", "t.kids === 2 ? '和小美' : ''"]]}, "cinema-067": {"raw": "好，這是電影票，這是學生證。", "pos": 50452, "ph": []}, "cinema-068": {"raw": "好，這是電影票。學生證忘了帶，沒關係吧？", "pos": 50470, "ph": []}, "cinema-069": {"raw": "電影票給你，學生證不用看吧？", "pos": 50494, "ph": []}, "cinema-070": {"raw": "學生票一定要出示學生證；沒有學生證的話，要補差價買全票。", "pos": 50637, "ph": []}, "cinema-071": {"raw": "學生票要看學生證，這是規定。", "pos": 50877, "ph": []}, "cinema-072": {"raw": "很好！買學生票，記得帶學生證。", "pos": 51123, "ph": []}, "cinema-073": {"raw": "驗票員：好，沒問題。請進，祝你們看得開心！", "pos": 51301, "ph": []}, "cinema-074": {"raw": "（電影院裡有好幾個廳，每個門口都寫著廳號。）", "pos": 51643, "ph": []}, "cinema-075": {"raw": "我：我們的票上寫幾廳呢？", "pos": 51824, "ph": []}, "cinema-076": {"raw": "走進${CN[h]}廳", "pos": 51974, "ph": [["第幾廳", "CN[h]"]]}, "cinema-077": {"raw": "票上寫的是${CN[t.hall]}廳。", "pos": 52119, "ph": [["第幾廳", "CN[t.hall]"]]}, "cinema-078": {"raw": "（你走進去，發現裡面在放另一部電影！你趕快走出來。）", "pos": 52237, "ph": []}, "cinema-079": {"raw": "你會看票上的廳號，很棒！", "pos": 52464, "ph": []}, "cinema-080": {"raw": "（你找到${CN[t.hall]}廳，走進去，裡面很暗。）", "pos": 52623, "ph": [["第幾廳", "CN[t.hall]"]]}, "cinema-081": {"raw": "（電影快開始了。你們走到座位，可是有一位阿伯坐在你們的位子上。）", "pos": 52986, "ph": []}, "cinema-082": {"raw": "阿伯：欸，這個位子是我的吧？", "pos": 53249, "ph": []}, "cinema-083": {"raw": "不好意思，我們的票是${seatZh(Game.chosen)}，請你再看一下票。", "pos": 53378, "ph": [["你買的座位", "seatZh(Game.chosen)"]]}, "cinema-084": {"raw": "好吧，你坐，我們去坐別的位子。", "pos": 53423, "ph": []}, "cinema-085": {"raw": "喂！你坐錯了，快起來！", "pos": 53442, "ph": []}, "cinema-086": {"raw": "票上有位子，要坐票上的位子（對號入座），不能隨便讓給別人。", "pos": 53643, "ph": []}, "cinema-087": {"raw": "要有禮貌，先說「不好意思」，再請他看票。", "pos": 53878, "ph": []}, "cinema-088": {"raw": "阿伯：謝謝你喔。", "pos": 54081, "ph": []}, "cinema-089": {"raw": "阿伯：什麼？你怎麼這麼沒禮貌！", "pos": 54125, "ph": []}, "cinema-090": {"raw": "你很有禮貌，也很清楚。這樣不會吵架！", "pos": 54264, "ph": []}, "cinema-091": {"raw": "阿伯：喔，對不起對不起，我看錯了！", "pos": 54426, "ph": []}, "cinema-092": {"raw": "（燈暗了，電影開始了。突然，你的手機響了！）", "pos": 54670, "ph": []}, "cinema-093": {"raw": "馬上把手機調成靜音。", "pos": 54876, "ph": []}, "cinema-094": {"raw": "大聲接電話：「喂？」", "pos": 54890, "ph": []}, "cinema-095": {"raw": "打開手機看訊息。", "pos": 54904, "ph": []}, "cinema-096": {"raw": "電影院裡要安靜，手機要調成靜音。", "pos": 55038, "ph": []}, "cinema-097": {"raw": "手機的螢幕很亮，會影響旁邊的人。", "pos": 55200, "ph": []}, "cinema-098": {"raw": "很好！看電影以前，要把手機調成靜音。", "pos": 55413, "ph": []}, "cinema-099": {"raw": "（電影結束了，燈亮起來。）", "pos": 56274, "ph": []}, "cinema-100": {"raw": "Ami：哇，這部電影超好看的！謝謝你幫我們買票，${N}，你太厲害了！", "pos": 56401, "ph": [["名字", "N"]]}, "cinema-101": {"raw": "（電影結束了。因為${why[0]}，你們錯過了前面的劇情。）", "pos": 56638, "ph": [["原因", "why[0]"]]}, "cinema-102": {"raw": "Ami：沒關係啦！下次我們早一點來，先看清楚票上的字！", "pos": 56841, "ph": []}}