  /* ── 畫面元件 ── */
  listHTML() {
    const t = this.task, r = s => this.ruby(s), d = this.done;
    const tc = TCOL[t.tColor], ac = ACOL[t.aColor];
    const rows = [
      { k: 'T', zh: `弟弟：${t.tColor}T恤，${t.tSize}號`, es: `Hermano: camiseta ${tc[0]}, talla ${t.tSize}`, en: `Brother: ${tc[1]} T-shirt, size ${t.tSize}` },
      { k: 'A', zh: `妹妹：${t.aColor}的髮夾，一個`, es: `Hermana: un pasador ${ac[0]}`, en: `Sister: one ${ac[1]} hairpin` },
      { k: 'F', zh: `晚餐：雞排${t.chicken}份，一份不要辣（奶奶的），要切`, es: `Cena: ${t.chicken} porciones de pollo frito, una sin picante (la de la abuela), cortado`, en: `Dinner: ${t.chicken} servings of fried chicken, one not spicy (grandma's), cut up` }
    ];
    const rule = L('衣服、飾品可以殺價，吃的不要殺價。', 'En ropa y accesorios se puede regatear; en la comida no.', 'You can haggle for clothes and accessories, but not for food.');
    const all = [...rows, rule];
    this._spk.push({ text: all.map(x => x.zh.replace('：', '，')).join('。'), who: 'Ami' });
    const sp1 = spkBtn(this._spk.length - 1, '朗讀 ' + X('Escuchar', 'Listen'));
    this._tr.push({ zh: all.map(x => x.zh).join(' '), es: all.map(x => x.es).join(' '), en: all.map(x => x.en).join(' ') });
    const tr1 = `<button class="tr-btn" data-tr="${this._tr.length - 1}" aria-label="翻譯 Traducir">${TR_ICON}</button>`;
    return `<div class="list"><div class="t">${r('Ami 的購物清單')}<span class="grow"></span>${sp1}${tr1}</div>` +
      rows.map(x => `<div class="${d[x.k] ? 'done' : ''}">${d[x.k] ? '✔' : '□'} ${r(x.zh)}</div>`).join('') +
      `<div class="rule">${r(rule.zh)}</div></div>`;
  },
  mapHTML() {
    const r = s => this.ruby(s), d = this.done;
    const s = (k, e, name) => `<div class="stall ${d[k] ? 'done' : ''}"><span class="e">${e}</span>${r(name)}${d[k] ? '<br>✔' : ''}</div>`;
    return `<div class="stalls">${s('T', '👕', '衣服攤')}${s('A', '🎀', '飾品攤')}${s('F', '🍗', '雞排攤')}</div>`;
  },
  haggleHTML(st) {
    const r = s => this.ruby(s);
    const faces = ['😡', '😠', '😐', '😊'];
    const old = st.history.map(p => `<span class="old">${p}</span>`).join('');
    return `<div class="haggle">
      <div class="tag"><div class="item">${r(st.item)}</div>${old}<div class="now">${st.ask}<small>${r('元')}</small></div></div>
      <div class="mood"><span class="face">${faces[st.mood]}</span>
        <span class="bar">${[1, 2, 3].map(i => `<i class="${i <= st.mood ? 'on' : ''}"></i>`).join('')}</span>
        <span class="lbl">${r(this.vend() + '的心情')}</span></div></div>`;
  },

  /* ── 殺價引擎 ── */
  vend() { return this._stall === 'A' ? '老闆娘' : '老闆'; },
  setAsk(st, price) { if (price !== st.ask) { st.history.push(st.ask); st.ask = price; } },
  haggleOptions(st) {
    const opts = [];
    if (!st.soft && st.mood > 0) opts.push('老闆，算便宜一點啦！');
    if (st.mood > 0) {
      const raw = [r10(st.ask * 0.5), r10(st.ask * 0.72), r10(st.ask * 0.88)].filter(n => n < st.ask && n > 0);
      [...new Set(raw)].forEach(n => opts.push(`${n}元可以嗎？`));
      if (!st.walked) opts.push('我再看看好了。');
    }
    opts.push(`好，${st.ask}元，我買了。`);
    return opts;
  },
  haggleChoose(st, c) {
    const V = this.vend();
    const say = (zh, es, en) => L(`${V}：${zh}`, es, en);
    if (c.startsWith('好，')) { this.state = 'PAY'; return; }
    if (c.startsWith('老闆，算便宜')) {
      st.soft = true;
      const p = Math.max(st.floor, r10(st.ask * 0.9));
      if (p < st.ask) {
        this.setAsk(st, p);
        this.thought = [say(`好啦好啦，看你很有誠意，${p}元！`, `Está bien, está bien, veo que lo dices en serio: ¡${esM(p)}!`, `All right, all right, you seem sincere: ${enM(p)}!`)];
      } else this.thought = [say('已經是最便宜的了啦！', '¡Ya es el precio más bajo!', "That's already the lowest price!")];
      return;
    }
    if (c.startsWith('我再看看')) {
      st.walked = true;
      if (st.ask > st.floor) {
        const p = Math.max(st.floor, r10(st.ask - (st.ask - st.floor) * 0.6));
        this.setAsk(st, p);
        this.thought = [L('（你轉身要走……）', '(Te das la vuelta para irte…)', '(You turn to leave…)'),
          say(`欸欸欸，等一下！${p}元賣你啦！`, `¡Eh, eh, espera! ¡Te lo vendo por ${esM(p)}!`, `Hey, hey, wait! I'll sell it to you for ${enM(p)}!`)];
        this.good('你說了「再看看」，老闆就降價了！', 'Dijiste «mirar un poco más» y el vendedor bajó el precio.', 'You said you\'d look around some more, and the vendor dropped the price!');
      } else this.thought = [say('這已經是最低價了，不買就算了。', 'Este ya es el precio más bajo; si no compras, no importa.', "That's already my lowest price. If you don't want it, never mind.")];
      return;
    }
    const o = +c.match(/^(\d+)/)[1];
    if (o >= st.floor) {
      this.setAsk(st, o);
      this.thought = [say(`唉，好啦好啦，算你${o}元！`, `Ay, está bien, está bien: ¡te lo dejo en ${esM(o)}!`, `Ugh, fine, fine — ${enM(o)} for you!`)];
      this.state = 'PAY'; return;
    }
    if (o >= st.floor * 0.8) {
      const p = Math.max(st.floor, r10((o + st.ask) / 2));
      this.setAsk(st, p);
      this.thought = [say(`${o}元太少了啦！${p}元，不能再少了。`, `¡${esM(o)} es muy poco! ${esM(p)}, no puedo bajar más.`, `${enM(o)} is too low! ${enM(p)}, and that's final.`)];
      return;
    }
    st.mood -= 1;
    if (st.mood === 0) {
      this.addMistake(M('殺價殺太兇，老闆生氣了。', 'Regateaste demasiado y el vendedor se enojó.', 'You haggled too aggressively and the vendor got angry.'),
        [say(`${o}元？你在開玩笑嗎？不二價，${st.ask}元，要買不買隨便你！`, `¿${esM(o)}? ¿Estás bromeando? Precio fijo: ${esM(st.ask)}; si quieres, compra, y si no, tú sabrás.`, `${enM(o)}? Are you kidding? Fixed price: ${enM(st.ask)}. Buy it or don't, up to you!`)]);
    } else {
      this.thought = [say(`${o}元？這樣我會虧本耶！`, `¿${esM(o)}? ¡Así pierdo dinero!`, `${enM(o)}? I'd lose money like that!`)];
    }
  },

