<!-- ── 登入 ── -->
<div id="login-screen" class="screen active">
  <div class="lanterns" aria-hidden="true"><span>夜</span><span>市</span></div>
  <h1 style="margin:0;font-size:30px;letter-spacing:2px">逛夜市殺價</h1>
  <p class="subtitle" data-es="Regateo en el mercado nocturno" data-en="Haggling at the night market">Regateo en el mercado nocturno</p>
  <div class="input-group">
    <label for="player-name-input">你的名字 / <span data-es="Tu nombre" data-en="Your name">Tu nombre</span></label>
    <input type="text" id="player-name-input" placeholder="例：María、小明" maxlength="20" autocomplete="off">
    <span class="error-msg" id="name-error"></span>
  </div>
  <div class="seg-group">
    <div class="seg" role="group" aria-label="中文字體">
      <button type="button" data-script="trad" aria-pressed="true">繁體</button>
      <button type="button" data-script="simp" aria-pressed="false">简体</button>
    </div>
    <div class="seg" role="group" aria-label="Idioma / Language">
      <button type="button" data-lang="es" aria-pressed="true">Español</button>
      <button type="button" data-lang="en" aria-pressed="false">English</button>
    </div>
  </div>
  <button class="btn-primary" onclick="startGame()">開始遊戲</button>
