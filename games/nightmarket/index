        options: () => [`不好意思，這件可以換${t.bigSize}號嗎？`, '這件太小了，我要退錢。', '你賣的衣服太小了啦！'],
        next: c => {
          if (c.startsWith('不好意思')) { Game.state = 'X_PRICE'; return; }
          if (c.startsWith('這件太小'))
            Game.addMistake(M('Ami的弟弟要的是換尺寸，不是退錢。', 'Su hermano quería cambiar la talla, no pedir un reembolso.', 'Her brother wants a different size, not a refund.'),
              [L('老闆：退錢喔？不行耶……你要不要換一件？', '¿Devolución? No se puede… ¿quieres cambiarla por otra?', "A refund? Can't do that… Want to swap it for another one?")]);
          else
            Game.addMistake(M('對老闆不禮貌。', 'Fuiste descortés con el vendedor.', 'You were rude to the vendor.'),
              [L('老闆：欸，是你自己選的耶！', '¡Oye, tú mismo la elegiste!', 'Hey, you picked it yourself!')]);
        }
      },
      X_PRICE: {
        place: 'T',
        dialogue: () => [L(`老闆：可以啊，可是${t.bigSize}號要多加五十塊喔。`, `Se puede, pero la talla ${t.bigSize} cuesta cincuenta dólares más.`, `Sure, but size ${t.bigSize} costs fifty dollars extra.`)],
        options: ['好，加五十塊。', '老闆，你剛剛不是說每個尺寸都一樣價錢嗎？'],
        next: c => {
          if (c.startsWith('好')) {
            Game.addMistake(M('老闆一開始說每個尺寸都一樣價錢。', 'El vendedor había dicho que todas las tallas cuestan igual.', 'The vendor had said every size costs the same.'),
              [L('老闆：謝啦！', '¡Gracias!', 'Thanks!')]);
            Game.cash -= 50; Game.updateCash(); b.xlPaid = 50;
          } else {
            Game.good('你記得老闆說每個尺寸都一樣價錢。', 'Recordaste que el vendedor dijo que todas las tallas cuestan igual.', 'You remembered the vendor said every size costs the same.');
            Game.thought = [L('老闆：哈哈，被你發現了！好啦好啦，直接換給你，不用加錢。', '¡Jaja, me descubriste! Está bien, te la cambio directamente, sin cobrarte más.', "Haha, you caught me! Fine, fine — I'll just swap it, no extra charge.")];
          }
          Game.stopTimer();
          Game.state = 'END';
        }
      },

      /* ═══ 結局 ═══ */
      END: {
        place: 'market',
        dialogue: () => {
          const bonus = Math.min(20, Math.floor(Game.saved / 10));
          Game._bonus = bonus;
          Game.score += bonus;
          document.getElementById('score-badge').textContent = Game.score + ' 分';
          Game._endGood = Game.mistakes <= 2;
          track('game_complete', { game: 'nightmarket', score: Game.score, elapsed: Game.elapsedTime, saved: Game.saved });
          const spent = 1000 - Game.cash;
          const lines = [
            L('（你跟Ami、奶奶會合了。）', '(Te reúnes con Ami y su abuela.)', '(You meet up with Ami and her grandma.)'),
            L(`我：Ami，東西都買好了！一共花了${spent}元，還剩${Game.cash}元。`, `¡Ami, ya compré todo! Gasté ${esM(spent)} en total y sobraron ${esM(Game.cash)}.`, `Ami, I got everything! I spent ${enM(spent)} in total, and ${enM(Game.cash)} is left.`)
          ];
          if (Game.saved > 0) lines.push(L(`我：衣服和髮夾，我殺價省了${Game.saved}元！`, `¡En la ropa y el pasador regateé y ahorré ${esM(Game.saved)}!`, `I haggled on the shirt and the hairpin and saved ${enM(Game.saved)}!`));
          lines.push(Game._endGood
            ? L(`Ami：哇，${N}，你比我還會殺價耶！下次逛夜市都帶你來！`, `¡Vaya, ${N}, regateas mejor que yo! ¡La próxima vez que vayamos al mercado nocturno te traigo!`, `Wow, ${N}, you're better at haggling than I am! I'll bring you every time we go to the night market!`)
            : L('Ami：辛苦了！有些地方下次再注意就好。', '¡Gracias por el esfuerzo! La próxima vez cuida unos detallitos y listo.', "Thanks for your hard work! Just watch out for a few things next time."));
          lines.push(L(`（殺價獎勵：每省10元加1分，這次加${bonus}分）`, `(Bonificación por regatear: 1 punto por cada ${esM(10)} ahorrados; esta vez +${bonus}.)`, `(Haggling bonus: 1 point for every ${enM(10)} saved; this time +${bonus}.)`));
          return lines;
        },
        options: () => ['查看結果 ' + X('Ver resultado', 'See results')],
        next: () => { Game.state = 'RESULT'; }
      },
      RESULT: {
        place: 'market',
        dialogue: () => {
          const w = (zh, es, en) => zh + ' ' + X(es, en);
          let msg = `【${w('任務成果', 'Resultados', 'Results')}】\n${w('玩家', 'Jugador', 'Player')}：${N}\n${w('最後分數', 'Puntos', 'Score')}：${Game.score} 分（${w('殺價獎勵', 'bonificación', 'bonus')} +${Game._bonus}）\n` +
            `${w('殺價省下', 'Ahorro', 'Saved')}：${Game.saved} 元\n` +
            `${w('錯誤次數', 'Errores', 'Mistakes')}：${Game.mistakes} 次\n${w('時間', 'Tiempo', 'Time')}：${Game.elapsedTime} 秒\n` +
            `${w('看任務提示', 'Pistas consultadas', 'Hints viewed')}：${Game.hintViews} 次\n\n${w('扣分原因', 'Penalizaciones', 'Penalties')}：`;
          if (!Game.log.length) msg += '\n沒有扣分！' + X('¡Sin errores!', 'No mistakes!') + ' 🎉';
          else Game.log.forEach((m, i) => { msg += `\n${i + 1}. ${m.zh} ${X(m.es, m.en)}（−10）`; });
          return msg.split('\n').map(zh => ({ zh }));
        },
        options: () => EMBED ? ['回到地圖 ' + X('Volver al mapa', 'Back to the map')] : ['查看排行榜 ' + X('Ver clasificación', 'See leaderboard')],
        next: () => { if (EMBED) finishEmbed(); else showLeaderboard(); }
      }
    };
  },

  handleChoice(choice) {
    const cfg = this.getConfig()[this.state];
    Tr.closeAll();                       // 選了選項，翻譯視窗全部關掉
    Speech.stop();
    this.thought = null;
    this.feedback = [];
    const before = this.state;
    this.att[before] = (this.att[before] || 0) + 1;
    cfg.next(choice);
    this.thoughtFirst = this.state !== before;   // 換關卡時，過場的話放在對話前面
    if (this.thoughtFirst) this.visit += 1;
    if (document.getElementById('game-window').classList.contains('active')) this.render();
  },

  render() {
    const cfg = this.getConfig()[this.state];
    if (!cfg) { console.error('狀態錯誤：' + this.state); return; }
    const val = v => typeof v === 'function' ? v() : v;
    this.setPlace(val(cfg.place) || 'market');

    // END 的 dialogue 會決定結局，所以只算一次
    const raw = this.state === 'END' ? (this._endText ??= cfg.dialogue()) : val(cfg.dialogue);
    let [src, emoji] = this.IMAGES[this.state] || (this.state === 'HAGGLE'
      ? (this._stall === 'A' ? this.IMAGES.A_GREET : this.IMAGES.T_GREET) : ['', '🏮']);
    if (this.state === 'END' && !this._endGood) [src, emoji] = ['images/end_bad.jpg', '😅'];
    this.setImage(src, emoji);
    Vocab.render(this.state);
    if (Hints.open) Hints.render();
    Log.render();

    this._tr = []; this._spk = [];
    let html = (this.showList && this.state !== 'START') ? this.listHTML() : '';
    html += cfg.html ? cfg.html() : '';
    const th = this.thought ? `<div class="thought">${this.formatText(this.thought)}</div>` : '';
    const main = this.formatText(raw);
    html += this.thoughtFirst ? th + main : main + th;
    html += this.feedbackHTML();
    const box = document.getElementById('npc-dialogue');
    box.innerHTML = html;
    box.querySelectorAll('[data-tr]').forEach(btn => {
      btn.onclick = () => Tr.open(this._tr[+btn.dataset.tr], btn);
    });
    box.querySelectorAll('[data-spk]').forEach(btn => {
      btn.onclick = () => { const x = this._spk[+btn.dataset.spk]; Speech.speak(x.text, btn, x.who); };
    });

    const area = document.getElementById('options-area');
    area.className = '';
    area.innerHTML = '';
    const opts = val(cfg.options);
    area.classList.toggle('single', opts.length === 1 || opts.some(o => o.length > 12));
    opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'opt' + (/^好，\d+元，我買了/.test(opt) ? ' deal' : '');
      btn.innerHTML = this.ruby(opt);
      btn.onclick = () => this.handleChoice(opt);
      area.appendChild(btn);
    });
  }
};

/* 從「重新開始」回來，或嵌入模式：直接用帶進來的名字開始，跳過開始畫面 */
(() => {
  const name = EMBED ? QS.get('name') : QS.get('again');
  if (!name) return;
  if (!EMBED) history.replaceState(null, '', location.pathname);
  document.getElementById('player-name-input').value = name;
  startGame();
})();
</script>
