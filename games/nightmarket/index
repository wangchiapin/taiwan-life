const STAGE = {
  MAP: ['選攤位', 'elegir puesto', 'choosing a stall'],
  T_GREET: ['衣服攤', 'puesto de ropa', 'clothes stall'], T_SIZE: ['衣服攤', 'puesto de ropa', 'clothes stall'],
  A_GREET: ['飾品攤', 'puesto de accesorios', 'accessories stall'], A_QTY: ['飾品攤', 'puesto de accesorios', 'accessories stall'],
  HAGGLE: ['殺價', 'regateo', 'haggling'], PAY: ['付錢', 'pago', 'paying'],
  F_GREET: ['雞排攤', 'puesto de pollo frito', 'fried chicken stall'], F_SPICY: ['雞排攤', 'puesto de pollo frito', 'fried chicken stall'],
  F_CUT: ['雞排攤', 'puesto de pollo frito', 'fried chicken stall'], F_PAY: ['雞排攤', 'puesto de pollo frito', 'fried chicken stall'],
  CALL: ['Ami 來電', 'llamada de Ami', 'call from Ami'], X_GREET: ['換尺寸', 'cambio de talla', 'size exchange'], X_PRICE: ['換尺寸', 'cambio de talla', 'size exchange']
};
function stageOf() { const s = STAGE[Game.state]; return s ? [s[0], s[1], s[2]] : [Game.state, Game.state, Game.state]; }

const Log = {
  open: false,
  toggle(force) {
    this.open = force ?? !this.open;
    if (this.open) { Vocab.toggle(false); Hints.toggle(false); this.render(); }
