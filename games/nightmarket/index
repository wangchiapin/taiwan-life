const Game = {
  state: 'START',
  playerName: '你',
  showPinyin: false, showList: false,
  startTime: null, elapsedTime: 0, timerInterval: null,
  score: 100, mistakes: 0, mistakeLog: [],
  thought: null, thoughtFirst: false,   // 過場的話或選錯時的提示（台詞陣列）
  hintViews: 0,                  // 打開任務提示的次數
  log: [],                       // 錯誤紀錄（整局）
  feedback: [],                  // 這一步的回饋卡
  visit: 0,                      // 第幾次進入關卡（標出「現在這關」的錯誤）
  att: {},                       // 每一關選了幾次（第一次就對才給綠卡）
  done: {},                      // 已經買好的攤位
  saved: 0,                      // 殺價省下來的錢
  seenT: false,                  // 聽過衣服攤老闆說「每個尺寸一樣價錢」了嗎
  _stall: 'T',

  /* 圖片：檔案放在 images/，沒有檔案時會顯示 emoji 佔位 */
  IMAGES: {
    START: ['images/start.jpg', '🏮'],
    MAP: ['images/map.jpg', '🗺️'],
    T_GREET: ['images/tshirt.jpg', '👕'], T_SIZE: ['images/tshirt.jpg', '👕'],
    A_GREET: ['images/accessory.jpg', '🎀'], A_QTY: ['images/accessory.jpg', '🎀'],
    F_GREET: ['images/chicken.jpg', '🍗'], F_SPICY: ['images/chicken.jpg', '🌶️'], F_CUT: ['images/chicken.jpg', '🔪'], F_PAY: ['images/chicken.jpg', '🍗'],
    PAY: ['images/payment.jpg', '💵'],
    CALL: ['images/call.jpg', '📞'],
    X_GREET: ['images/tshirt.jpg', '👕'], X_PRICE: ['images/tshirt.jpg', '👕'],
    END: ['images/end_good.jpg', '🎉'],
    RESULT: ['images/result.jpg', '📊']
  },

  get N() { return this.playerName; },

  /* ── 每局隨機任務 ── */
  setup() {
    const tPrice = pick([350, 390, 420]);
    const aPrice = pick([120, 150, 180]);
    this.task = {
      tColor: pick(['黑色', '白色', '藍色']),
      tSize: pick(['M', 'L']),
      aColor: pick(['粉紅色', '紫色', '黃色']),
      chicken: pick([3, 4]),
      chickenPrice: pick([80, 85, 90])
    };
    this.task.bigSize = this.task.tSize === 'M' ? 'L' : 'XL';
    // 每個攤位：開價、底價（老闆最低願意賣的價錢）
    this.stalls = {
      T: { item: 'T恤', es: 'La camiseta', en: 'The T-shirt', ask: tPrice, start: tPrice, floor: r10(tPrice * (0.68 + Math.random() * 0.1)), mood: 3, soft: false, walked: false, history: [] },
      A: { item: '髮夾', es: 'El pasador', en: 'The hairpin', ask: aPrice, start: aPrice, floor: r10(aPrice * (0.62 + Math.random() * 0.1)), mood: 3, soft: false, walked: false, history: [] }
    };
    this.cash = 1000;
    this.bought = { xlPaid: 0 };
  },

  /* ── 計時 ── */
  startTimer() {
    this.startTime = Date.now();
    this.timerInterval = setInterval(() => {
      this.elapsedTime = Math.floor((Date.now() - this.startTime) / 1000);
      const m = Math.floor(this.elapsedTime / 60), s = String(this.elapsedTime % 60).padStart(2, '0');
      document.getElementById('timer-display').textContent = `⏱ ${m}:${s}`;
    }, 1000);
  },
  stopTimer() { clearInterval(this.timerInterval); },
  updateCash() { document.getElementById('cash-badge').textContent = '💵 ' + money(this.cash); },

  /* ── 扣分與回饋 ── */
  addMistake(r, thought) {
    this.score -= 10; this.mistakes += 1; this.mistakeLog.push(r.zh + ' ' + r.es);
    this.log.push({ ...r, stage: stageOf(), visit: this.visit });
    if (this.state !== 'END') this.feedback.push({ type: 'bad', ...r });
    document.getElementById('score-badge').textContent = this.score + ' 分';
    track('mistake', { game: 'nightmarket', state: this.state });
    if (thought) this.thought = thought;
    Log.render();
    if (this.mistakes >= 10 && this.state !== 'END') {
      setTimeout(() => { alert(Z('錯太多次了，從頭再來一次！') + ' ' + X('Demasiados errores. ¡Empieza otra vez!', 'Too many mistakes. Start over!')); restartGame(true); }, 300);
    }
  },
  good(zh, es, en) { this.feedback.push({ type: 'good', zh, es, en }); },
  feedbackHTML() {
    return this.feedback.map(f => `<div class="fb ${f.type}">
      <div class="fb-head">${f.type === 'bad' ? '✗ −10 分' : '✓ ' + X('¡Bien!', 'Nice!') + ' 做得好'}</div>
      <div class="fb-es">${esc(X(f.es, f.en))}</div><div class="fb-zh">${this.ruby(f.zh)}</div></div>`).join('');
  },
  toast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
    clearTimeout(this._toastTimer);
    this._toastTimer = setTimeout(() => t.classList.remove('show'), 3600);
  },

  /* ── 拼音／清單 ── */
  togglePinyin() {
    this.showPinyin = !this.showPinyin;
    document.getElementById('btn-pinyin').setAttribute('aria-pressed', this.showPinyin);
    this.render();
    if (Hints.open) Hints.render();
  },
  toggleList() {
    this.showList = !this.showList;
    document.getElementById('btn-list').setAttribute('aria-pressed', this.showList);
    this.render();
  },
  ruby(str) {
    if (!this.showPinyin) return esc(Z(str));
    return String(str).split(/([一-鿿]+)/).map(seg => {
      if (!/^[一-鿿]+$/.test(seg)) return esc(seg);
      const py = toPinyin(seg, true);                 // 台灣讀音由繁體算
      const shown = [...Z(seg)], orig = [...seg];
      const chars = shown.length === orig.length ? shown : orig;
      return chars.map((c, i) => `<ruby>${c}<rt>${py[i] || ''}</rt></ruby>`).join('');
    }).join('');
  },

  /* ── 台詞：每一行一個 div，有翻譯的在句尾加朗讀和翻譯小圖示 ── */
  formatText(content) {
    const items = Array.isArray(content) ? content : [content];
    return items.map(item => {
      const m = item.zh.match(SPEAKER_RE);
      let head = '', rest = item.zh;
      if (m) {
        const who = m[1] === '我' ? this.N : m[1];
        const cls = m[1] === 'Ami' ? 'speaker ami' : m[1] === '我' ? 'speaker me' : 'speaker';
        head = `<span class="${cls}">${this.ruby(who)}：</span>`;
        rest = item.zh.slice(m[0].length);
      }
      let btn = '';
      if (item.es) {
        this._spk.push({ text: rest, who: m ? m[1] : null });
        btn += spkBtn(this._spk.length - 1, '朗讀 ' + X('Escuchar', 'Listen'));
        this._tr.push(item);
        btn += `<button class="tr-btn" data-tr="${this._tr.length - 1}" aria-label="翻譯 Traducir">${TR_ICON}</button>`;
      }
      return `<div class="line">${head}${this.ruby(rest)}${btn}</div>`;
    }).join('');
  },

  /* ── 位置列 ── */
  setPlace(mode) {
    const map = {
      market: ['🏮', '夜市', X('Mercado nocturno', 'Night market'), ''],
      T: ['👕', '衣服攤', X('Puesto de ropa', 'Clothes stall'), ''],
      A: ['🎀', '飾品攤', X('Puesto de accesorios', 'Accessories stall'), ''],
      F: ['🍗', '雞排攤', X('Puesto de pollo frito', 'Fried chicken stall'), ''],
      phone: ['📞', 'Ami', '通話中 · ' + X('En llamada', 'On a call'), 'phone']
    };
    const [icon, who, st, cls] = map[mode] || map.market;
    document.getElementById('place-bar').className = cls;
    document.getElementById('place-icon').textContent = icon;
    document.getElementById('place-who').textContent = who;
    document.getElementById('place-status').textContent = st;
  },

  /* ── 圖片 ── */
  missing: new Set(),
  imageMissing() {
    const img = document.getElementById('npc-avatar'), ph = document.getElementById('scene-placeholder');
    if (img.getAttribute('src')) this.missing.add(img.getAttribute('src'));
    img.style.display = 'none'; ph.style.display = 'grid';
  },
  setImage(src, emoji) {
    const img = document.getElementById('npc-avatar'), ph = document.getElementById('scene-placeholder');
    ph.textContent = emoji;
    if (!src || this.missing.has(src)) { img.style.display = 'none'; ph.style.display = 'grid'; return; }
    img.style.display = 'block'; ph.style.display = 'none';
    if (img.getAttribute('src') !== src) img.setAttribute('src', src);
  },

  /* ── Ami 交代的話（任務提示也會用到） ── */
  amiLines() {
    const N = this.N;
    return [
      L(`Ami：${N}，我帶奶奶去洗手間，這一千塊先給你，幫我們買東西，好不好？`,
        `${N}, voy a llevar a mi abuela al baño. Te dejo estos mil dólares: ¿puedes comprar unas cosas por nosotras?`,
        `${N}, I'm taking my grandma to the restroom. Here's NT$1,000 for now. Can you buy a few things for us?`),
      L('Ami：要買的我都寫在清單上了。衣服和飾品可以殺價，但是吃的不要殺價喔，老闆會不高興。',
        'Todo lo que hay que comprar está en la lista. En la ropa y los accesorios se puede regatear, pero la comida no: al vendedor no le gusta.',
