const Game = {
  state: 'START',
  playerName: '你',
  showPinyin: false, showPhone: false,
  startTime: null, elapsedTime: 0, timerInterval: null,
  score: 100, mistakes: 0, mistakeLog: [],
  thought: null, thoughtFirst: false,   // 過場的話或選錯時的提示（台詞陣列）
  hintViews: 0,                  // 打開任務提示的次數
  log: [],                       // 錯誤紀錄（整局）
  feedback: [],                  // 這一步的回饋卡
  visit: 0,                      // 第幾次進入關卡（標出「現在這關」的錯誤）
  att: {},                       // 每一關選了幾次（第一次就對才給綠卡）

  /* 圖片：檔案放在 images/，沒有檔案時會顯示 emoji 佔位 */
  IMAGES: {
    START: ['images/start.jpg', '📱'],
    STORE: ['images/street.jpg', '🏪'],
    GREET: ['images/clerk.jpg', '🧑‍💼'],
    M_TAIL: ['images/clerk.jpg', '🔢'], M_NAME: ['images/clerk.jpg', '📝'], M_CHECK: ['images/box.jpg', '📦'],
    M_PAY: ['images/payment.jpg', '💵'], M_CHANGE: ['images/payment.jpg', '💵'],
    CALL: ['images/call.jpg', '📞'],
    D_TAIL: ['images/clerk.jpg', '🔢'], D_NAME: ['images/clerk.jpg', '📝'], D_CONFIRM: ['images/box.jpg', '📦'],
    Y_ASK: ['images/clerk.jpg', '📦'], Y_NOTFOUND: ['images/clerk.jpg', '🔍'], Y_NAME: ['images/clerk.jpg', '📝'], Y_CONFIRM: ['images/box.jpg', '📦'],
    CARD: ['images/card.jpg', '💳'], CARD_AMT: ['images/card.jpg', '💳'], CARD_TAP: ['images/card.jpg', '📶'],
    BAG: ['images/bag.jpg', '🛍️'],
    END: ['images/end_good.jpg', '🎉'],
    RESULT: ['images/result.jpg', '📊']
  },

  get N() { return this.playerName; },

  /* ── 每局隨機任務 ── */
  setup() {
    const fam = pick(['王', '李', '張']);
    const momName = pick([['林美華', ['林美樺', '林美玲']], ['陳淑芬', ['陳淑芳', '陳淑貞']], ['黃雅婷', ['黃雅亭', '黃雅琪']]]);
    const dadGiven = pick(['志明', '建國', '家豪']);
    const dadName = fam + dadGiven;
    let mt = tail3(), dt, yt;
    do { dt = tail3(); } while (dt === mt);
    do { yt = tail3(); } while (yt === mt || yt === dt);
    const store = EMBED_STORE || pick(STORES);
    this.task = {
      store, otherStore: pick(STORES.filter(s => s !== store)),
      momName: momName[0], momFake: momName[1],
      dadName, dadFake: [fam + dadGiven[0] + pick(['銘', '民']), pick(['林', '陳']) + dadGiven],
      momTail: mt, dadTail: dt, yourTail: yt,
      momNo: randDigits(4) + '-' + randDigits(4),
      fakeNo: randDigits(4) + '-' + randDigits(4),
      dadNo: randDigits(4) + '-' + randDigits(4),
      yourNo: randDigits(4) + '-' + randDigits(4),
      cod: pick([590, 680, 745]),                         // 房東太太的包裹要取貨付款
      dadSender: pick(['網路書店', '電器行']),
      yourArrived: Math.random() < 0.5,                    // 你的包裹到了沒？
      today: 5,
      cardTop: pick([300, 500])
    };
    this.cash = 1000 + this.task.cardTop;
    this.got = { mom: false, dad: false, yours: false, waited: false, card: 0, bag: false };
  },

  /* ── 計時 ── */
  startTimer() {
    this.startTime = Date.now();
    this.timerInterval = setInterval(() => {
      this.elapsedTime = Math.floor((Date.now() - this.startTime) / 1000);
      const m = Math.floor(this.elapsedTime / 60), s = String(this.elapsedTime % 60).padStart(2, '0');
      document.getElementById('timer-display').textContent = `⏱ ${m}:${s}`;
    }, 1000);
  },
  stopTimer() { clearInterval(this.timerInterval); },
  updateCash() { document.getElementById('cash-badge').textContent = '💵 ' + money(this.cash); },

  /* ── 扣分與回饋 ── */
  addMistake(r, thought) {
    this.score -= 10; this.mistakes += 1; this.mistakeLog.push(r.zh + ' ' + r.es);
    this.log.push({ ...r, stage: stageOf(), visit: this.visit });
    if (this.state !== 'END') this.feedback.push({ type: 'bad', ...r });
    document.getElementById('score-badge').textContent = this.score + ' 分';
    track('mistake', { game: 'parcel', state: this.state });
    if (thought) this.thought = thought;
    Log.render();
    if (this.mistakes >= 10 && this.state !== 'END') {
      setTimeout(() => { alert(Z('錯太多次了，從頭再來一次！') + ' ' + X('Demasiados errores. ¡Empieza otra vez!', 'Too many mistakes. Start over!')); restartGame(true); }, 300);
    }
  },
  good(zh, es, en) { this.feedback.push({ type: 'good', zh, es, en }); },
  feedbackHTML() {
    return this.feedback.map(f => `<div class="fb ${f.type}">
      <div class="fb-head">${f.type === 'bad' ? '✗ −10 分' : '✓ ' + X('¡Bien!', 'Nice!') + ' 做得好'}</div>
      <div class="fb-es">${esc(X(f.es, f.en))}</div><div class="fb-zh">${this.ruby(f.zh)}</div></div>`).join('');
  },
  toast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.classList.add('show');
