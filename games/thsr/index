  bubble(cls, fromZh, lines, who) {
    const r = s => this.ruby(s);
    this._spk.push({ text: lines.map(l => l.zh).join('。'), who: who || null });
    const sp1 = spkBtn(this._spk.length - 1, '朗讀 ' + X('Escuchar', 'Listen'));
    this._tr.push({ zh: lines.map(l => l.zh).join(' '), es: lines.map(l => l.es).join(' '), en: lines.map(l => l.en).join(' ') });
    const tr1 = `<button class="tr-btn" data-tr="${this._tr.length - 1}" aria-label="翻譯 Traducir">${TR_ICON}</button>`;
    const body = lines.map(l => {
      const z = r(l.zh);
      return l.warn ? `<span class="warn">${z}</span>` : l.b ? `<b>${z}</b>` : z;
    }).join('<br>');
    return `<div class="${cls}"><div class="from">${r(fromZh)}</div>${body}${tr1}${sp1}</div>`;
  },
