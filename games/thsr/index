    const t = this.task, r = s => this.ruby(s);
    const mine = this.bubble('sms', `簡訊（你的手機）　今天是10/${t.today}`, this.yourSmsLines());
    return `<div class="sms-wrap">${this.bubble('line-msg', '房東太太', this.lineMsgs(), '房東太太')}` +
      `${this.bubble('sms', '簡訊（房東太太轉傳）', this.momSmsLines())}${mine}</div>`;
  },
