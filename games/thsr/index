        next: c => {
          if (c.startsWith('給')) {
            Game.addMistake(M('已經付過款了，不用再付。', 'Ya estaba pagado; no hay que pagar otra vez.', 'It was already paid; no need to pay again.'),
              [L('店員：不用不用，已經付過了！', '¡No, no hace falta, ya está pagado!', "No, no, it's already paid!")]); return;
          }
          g.yours = true; Game.state = 'CARD';
        }
      },

      /* ═══ 悠遊卡加值 ═══ */
      CARD: {
        place: 'store',
        dialogue: () => [L('店員：還有其他需要嗎？', '¿Necesita algo más?', 'Anything else?')],
        options: () => (Game._cd ||= shuffle(['我要幫悠遊卡加值。', '我要買一張新的悠遊卡。', '沒有了，謝謝。'])),
        next: c => {
          if (c.startsWith('我要幫')) { Game.state = 'CARD_AMT'; return; }
          if (c.startsWith('沒有'))
            Game.addMistake(M('房東太太還請你幫悠遊卡加值。', 'La casera también te pidió recargar su EasyCard.', 'The landlady also asked you to top up her EasyCard.'),
              [L('（等等，房東太太還交代了一件事……）', '(Espera, la casera te encargó una cosa más…)', '(Wait, the landlady asked for one more thing…)')]);
          else
            Game.addMistake(M('不用買新的，是幫房東太太的卡加值。', 'No hace falta una tarjeta nueva; hay que recargar la de la casera.', "No need for a new card; top up the landlady's card."),
              [L('店員：新卡一張一百元喔。', 'Una tarjeta nueva cuesta cien dólares.', 'A new card costs 100 dollars.'),
               L('我：啊不是，我是要加值！', 'Ay no, ¡quiero recargar!', "Oh no, I want to top up!")]);
        }
      },
      CARD_AMT: {
        place: 'store',
        dialogue: () => [L('店員：要加多少？', '¿Cuánto quiere recargar?', 'How much would you like to add?')],
        options: ['一百元', '三百元', '五百元', '一千元'],
        next: c => {
          const n = { '一百元': 100, '三百元': 300, '五百元': 500, '一千元': 1000 }[c];
          if (n !== t.cardTop) {
            Game.addMistake(M(`房東太太說加值${t.cardTop}元。`, 'La casera dijo otra cantidad.', 'The landlady said a different amount.'),
              [L('（房東太太說加多少？看一下LINE……）', '(¿Cuánto dijo la casera? Mira el LINE…)', '(How much did the landlady say? Check LINE…)')]); return;
          }
          g.card = n; Game.state = 'CARD_TAP';
        }
      },
      CARD_TAP: {
        place: 'store',
        dialogue: () => [L(`店員：好，${t.cardTop}元，麻煩把卡放在感應區上面。`, `Muy bien, ${esM(t.cardTop)}; por favor ponga la tarjeta sobre la zona de lectura.`, `OK, ${enM(t.cardTop)}. Please place the card on the reader.`)],
        options: ['把卡放在感應區上', '把卡交給店員', '把卡插進收銀機'],
        next: c => {
          if (!c.includes('感應區')) {
            Game.addMistake(M('要把卡放在感應區上。', 'Debes poner la tarjeta sobre el lector.', 'Place the card on the reader.'),
              [L('店員：放在這邊的感應區上面就好喔。', 'Basta con ponerla aquí, en la zona de lectura.', 'Just place it here on the reader.')]); return;
          }
          Game.cash -= t.cardTop; Game.updateCash();
          Game.thought = [L('（嗶！）', '(¡Bip!)', '(Beep!)'), L('店員：加值好了。', 'Listo, ya está recargada.', 'Your card is topped up.')];
          Game.state = 'BAG';
        }
      },
      BAG: {
        place: 'store',
        dialogue: () => [L('店員：東西有點多，需要袋子嗎？一個兩塊。', 'Son varias cosas; ¿necesita una bolsa? Cuesta dos dólares.', "You have quite a few things. Need a bag? It's 2 dollars.")],
        options: ['要，買一個袋子。', '不用，我自己拿就好，謝謝。'],
        next: c => {
          if (c.startsWith('要')) {
            g.bag = true;
            Game.addMistake(M('房東太太說不要再買袋子。', 'La casera dijo que no compraras más bolsas.', 'The landlady said not to buy any more bags.'));
            Game.cash -= 2; Game.updateCash();
          } else Game.good('你記得房東太太說不要再買袋子。', 'Recordaste que la casera dijo que no compraras más bolsas.', 'You remembered the landlady said not to buy more bags.');
          Game.stopTimer();
          Game.state = 'END';
        }
      },

      /* ═══ 結局 ═══ */
      END: {
        place: 'home',
        dialogue: () => {
          const good = Game.mistakes <= 2;
          Game._endGood = good;
          track('game_complete', { game: 'parcel', score: Game.score, elapsed: Game.elapsedTime });
          const zhItems = ['您的包裹', '房東先生的包裹'], esItems = ['su paquete', 'el paquete del casero'], enItems = ['your parcel', "the landlord's parcel"];
          if (g.yours) { zhItems.push('我自己的包裹'); esItems.push('mi propio paquete'); enItems.push('my own parcel'); }
          const joinEs = a => a.length > 2 ? a.slice(0, -1).join(', ') + ' y ' + a[a.length - 1] : a.join(' y ');
          const joinEn = a => a.length > 2 ? a.slice(0, -1).join(', ') + ', and ' + a[a.length - 1] : a.join(' and ');
          const lines = [
            L('（晚上，房東太太下班回來了。）', '(Por la noche, la casera vuelve del trabajo.)', '(In the evening, your landlady comes home from work.)'),
            L(`我：房東太太，${zhItems.join('、')}都拿回來了，悠遊卡也加值了${t.cardTop}元。`,
              `Casera, ya traje ${joinEs(esItems)}, y también recargué la EasyCard con ${esM(t.cardTop)}.`,
              `Landlady, I brought back ${joinEn(enItems)}, and I topped up the EasyCard with ${enM(t.cardTop)}.`)
          ];
          if (!t.yourArrived) lines.push(L(`我：我的包裹還沒到，簡訊說10/${t.today + 2}才會到。`, `Mi paquete aún no llega; el mensaje dice que llegará el 10/${t.today + 2}.`, `My parcel hasn't arrived yet; the text says it will arrive on 10/${t.today + 2}.`));
          lines.push(L(`我：這是剩下的${money(Game.cash)}。`, `Aquí está el dinero que sobró: ${esM(Game.cash)}.`, `Here's the money that's left: ${enM(Game.cash)}.`));
          lines.push(good
            ? L(`房東太太：哇，${N}，你真厲害！以後包裹都靠你了！`, `¡Vaya, ${N}, eres genial! ¡De ahora en adelante los paquetes quedan en tus manos!`, `Wow, ${N}, you're amazing! From now on, I'll leave the parcels to you!`)
            : L('房東太太：謝謝你！有些小地方要再注意，慢慢就習慣了。', '¡Gracias! Hay unos detallitos que cuidar, pero poco a poco te acostumbrarás.', "Thank you! There are a few small things to watch out for, but you'll get used to it."));
          return lines;
        },
        options: () => ['查看結果 ' + X('Ver resultado', 'See results')],
        next: () => { Game.state = 'RESULT'; }
      },
      RESULT: {
        place: 'home',
        dialogue: () => {
          const w = (zh, es, en) => zh + ' ' + X(es, en);
          let msg = `【${w('任務成果', 'Resultados', 'Results')}】\n${w('玩家', 'Jugador', 'Player')}：${N}\n${w('最後分數', 'Puntos', 'Score')}：${Game.score} 分\n` +
            `${w('錯誤次數', 'Errores', 'Mistakes')}：${Game.mistakes} 次\n${w('時間', 'Tiempo', 'Time')}：${Game.elapsedTime} 秒\n` +
            `${w('看任務提示', 'Pistas consultadas', 'Hints viewed')}：${Game.hintViews} 次\n\n${w('扣分原因', 'Penalizaciones', 'Penalties')}：`;
          if (!Game.log.length) msg += '\n沒有扣分！' + X('¡Sin errores!', 'No mistakes!') + ' 🎉';
          else Game.log.forEach((m, i) => { msg += `\n${i + 1}. ${m.zh} ${X(m.es, m.en)}（−10）`; });
          return msg.split('\n').map(zh => ({ zh }));
        },
        options: () => EMBED ? ['回到地圖 ' + X('Volver al mapa', 'Back to the map')] : ['查看排行榜 ' + X('Ver clasificación', 'See leaderboard')],
        next: () => { if (EMBED) finishEmbed(); else showLeaderboard(); }
      }
    };
  },

  handleChoice(choice) {
    const cfg = this.getConfig()[this.state];
    Tr.closeAll();                       // 選了選項，翻譯視窗全部關掉
    Speech.stop();
    this.thought = null;
    this.feedback = [];
    const before = this.state;
    this.att[before] = (this.att[before] || 0) + 1;
    cfg.next(choice);
    this.thoughtFirst = this.state !== before;   // 換關卡時，過場的話放在對話前面
    if (this.thoughtFirst) this.visit += 1;
    if (document.getElementById('game-window').classList.contains('active')) this.render();
  },

  render() {
    const cfg = this.getConfig()[this.state];
    if (!cfg) { console.error('狀態錯誤：' + this.state); return; }
    const val = v => typeof v === 'function' ? v() : v;
    this.setPlace(val(cfg.place) || 'store');

    // END 的 dialogue 會決定結局，所以只算一次
    const raw = this.state === 'END' ? (this._endText ??= cfg.dialogue()) : val(cfg.dialogue);
    let [src, emoji] = this.IMAGES[this.state] || ['', '📦'];
    if (this.state === 'END' && !this._endGood) [src, emoji] = ['images/end_bad.jpg', '😅'];
    this.setImage(src, emoji);
    Vocab.render(this.state);
    if (Hints.open) Hints.render();
    Log.render();

    this._tr = []; this._spk = [];
    let html = (this.showPhone && this.state !== 'START') ? this.phoneHTML() : '';
    html += cfg.html ? cfg.html() : '';
    const th = this.thought ? `<div class="thought">${this.formatText(this.thought)}</div>` : '';
    const main = this.formatText(raw);
    html += this.thoughtFirst ? th + main : main + th;
    html += this.feedbackHTML();
    const box = document.getElementById('npc-dialogue');
    box.innerHTML = html;
    box.querySelectorAll('[data-tr]').forEach(btn => {
      btn.onclick = () => Tr.open(this._tr[+btn.dataset.tr], btn);
    });
    box.querySelectorAll('[data-spk]').forEach(btn => {
      btn.onclick = () => { const x = this._spk[+btn.dataset.spk]; Speech.speak(x.text, btn, x.who); };
    });

    const area = document.getElementById('options-area');
    area.className = '';
    area.innerHTML = '';
    const opts = val(cfg.options);
    area.classList.toggle('single', opts.length === 1 || opts.some(o => o.length > 12));
    opts.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'opt';
      btn.innerHTML = this.ruby(opt);
      btn.onclick = () => this.handleChoice(opt);
      area.appendChild(btn);
    });
  }
};

/* 從「重新開始」回來，或嵌入模式：直接用帶進來的名字開始，跳過開始畫面 */
(() => {
  const name = EMBED ? QS.get('name') : QS.get('again');
  if (!name) return;
  if (!EMBED) history.replaceState(null, '', location.pathname);
  document.getElementById('player-name-input').value = name;
  startGame();
})();
</script>
