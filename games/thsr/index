<!-- Firebase：與飲料店同一個專案，collection 換成 parcelgame_scores -->
<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getFirestore, collection, addDoc, query, orderBy, limit, getDocs }
      from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  const firebaseConfig = {
    apiKey:            "AIzaSyD2lxec6JTbERwFPGjDzriYzIH7o9IRWnw",
    authDomain:        "tiendadebebidas-d75ac.firebaseapp.com",
    projectId:         "tiendadebebidas-d75ac",
    storageBucket:     "tiendadebebidas-d75ac.firebasestorage.app",
    messagingSenderId: "1:947444542062:web:62e209f33cfc3ae12c547f",
    appId:             "G-PGQZPYNBLX"
  };
  const app = initializeApp(firebaseConfig);
  const db  = getFirestore(app);
  const COL = "parcelgame_scores";

  window._FB = {
    async saveScore(name, score, elapsed) {
      try { await addDoc(collection(db, COL), { name, score, elapsed, createdAt: Date.now() }); return true; }
      catch (e) { console.error("Firebase 寫入失敗", e); return false; }
    },
    async getLeaderboard() {
      try {
        // 需要在 Firestore 建立複合索引：score 降冪 + elapsed 升冪
        const q = query(collection(db, COL), orderBy("score", "desc"), orderBy("elapsed", "asc"), limit(15));
        const snap = await getDocs(q);
        return snap.docs.map(d => d.data());
      } catch (e) { console.error("Firebase 讀取失敗", e); return []; }
    }
  };
</script>


